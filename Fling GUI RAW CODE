	-- LocalScript → Inside ScreenGui
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local Workspace = game:GetService("Workspace")
	local Camera = Workspace.CurrentCamera
	
	local ScreenGui = script.Parent
	ScreenGui.Name = "FlingGui"
	ScreenGui.ResetOnSpawn = false
	
	-- Cleanup old GUIs
	for _, oldGui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
		if oldGui:IsA("ScreenGui") and oldGui ~= ScreenGui and oldGui.Name == "FlingGui" then
			oldGui:Destroy()
		end
	end
	
	local MainFrame = ScreenGui:WaitForChild("Frame")
	local ScrollingFrame = MainFrame:WaitForChild("ScrollingFrame")
	local Template = ScrollingFrame:WaitForChild("Template")
	Template.Visible = false 
	
	local ActiveFlings = {}
	local FlingThreads = {} -- Store threads to kill them instantly
	
	local function startFling(targetPlayer)
		if not targetPlayer or targetPlayer == LocalPlayer then return end
	
		-- Stop existing fling on this target first if any
		if FlingThreads[targetPlayer] then
			task.cancel(FlingThreads[targetPlayer])
			FlingThreads[targetPlayer] = nil
		end
		if ActiveFlings[targetPlayer] then return end
	
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
	
		if not hrp or not hum then return end
	
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = false 
				part.CanCollide = (part.Name == "HumanoidRootPart")
				part.Massless = true
			elseif part:IsA("Seat") or part:IsA("VehicleSeat") then
				part:Sit(nil)
			end
		end
	
		hum.PlatformStand = true
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	
		ActiveFlings[targetPlayer] = true
	
		-- Camera Thread
		local camThread = task.spawn(function()
			while ActiveFlings[targetPlayer] do
				task.wait()
				local targetChar = targetPlayer.Character
				local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
				if targetHRP then
					Camera.CameraSubject = targetHRP
				else
					break
				end
			end
			if char and char:FindFirstChildOfClass("Humanoid") then 
				Camera.CameraSubject = char:FindFirstChildOfClass("Humanoid") 
			end
		end)
	
		-- Fling Thread
		local flingThread = task.spawn(function()
			while ActiveFlings[targetPlayer] do
				task.wait() 
	
				local targetChar = targetPlayer.Character
				local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
				local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	
				-- INSTANT BREAK CHECK
				if not ActiveFlings[targetPlayer] then break end
	
				if not targetHRP or not targetHum or targetHum.Health <= 0 then
					break
				end
	
				local shakeX = math.random(-2, 2) * 0.4
				local shakeZ = math.random(-2, 2) * 0.4
				hrp.CFrame = targetHRP.CFrame * CFrame.new(shakeX, -1.5, shakeZ) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), 0)
	
				hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				hrp.AssemblyAngularVelocity = Vector3.new(0, 65000, 0)
			end
	
			-- Cleanup only if we exited naturally (not forced by stop)
			if not ActiveFlings[targetPlayer] then return end
	
			ActiveFlings[targetPlayer] = nil
			if char and hum and hrp then
				hum.PlatformStand = false
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hrp.CFrame = hrp.CFrame + Vector3.new(0, 8, 0)
				for _, part in pairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = true
						part.Massless = false
					end
				end
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
		end)
	
		FlingThreads[targetPlayer] = flingThread
	end
	
	local function stopFling(targetPlayer)
		if not targetPlayer then return end
		ActiveFlings[targetPlayer] = nil -- Set flag immediately
	
		-- Kill the thread instantly so it stops mid-cycle
		if FlingThreads[targetPlayer] then
			task.cancel(FlingThreads[targetPlayer])
			FlingThreads[targetPlayer] = nil
		end
	
		-- Immediate cleanup of character state
		local char = LocalPlayer.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hum then 
				hum.PlatformStand = false 
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
			if hrp then
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hrp.CFrame = hrp.CFrame + Vector3.new(0, 5, 0)
			end
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = true
					part.Massless = false
				end
			end
		end
	end
	
	-- ==================== UI ====================
	
	local function updateButtonState(clone, player)
		local TextButton = clone:FindFirstChild("TextButton")
		if not TextButton then return end
	
		if ActiveFlings[player] then
			TextButton.Text = "Flinging"
			TextButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		else
			TextButton.Text = "Fling"
			TextButton.BackgroundColor3 = Color3.fromRGB(60, 255, 100)
		end
	end
	
	local function createPlayerEntry(player)
		if ScrollingFrame:FindFirstChild(player.Name) then return end
	
		local clone = Template:Clone()
		clone.Name = player.Name
		clone.Parent = ScrollingFrame
		clone.Visible = true
	
		if clone:FindFirstChild("TextLabel") then clone.TextLabel.Text = player.Name end
	
		if clone:FindFirstChild("ImageLabel") then
			task.spawn(function()
				local success, thumb = pcall(function()
					return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
				end)
				if success and thumb then clone.ImageLabel.Image = thumb end
			end)
		end
	
		if clone:FindFirstChild("TextButton") then
			local btn = clone.TextButton
			updateButtonState(clone, player)
	
			btn.MouseButton1Click:Connect(function()
				local actualPlayer = Players:FindFirstChild(clone.Name)
				if not actualPlayer then return end
	
				if ActiveFlings[actualPlayer] then
					stopFling(actualPlayer)
				else
					startFling(actualPlayer)
				end
				-- Force UI update immediately
				updateButtonState(clone, actualPlayer)
			end)
		end
	end
	
	local function removePlayerEntry(player)
		local entry = ScrollingFrame:FindFirstChild(player.Name)
		if entry then entry:Destroy() end
	end
	
	-- Init
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then createPlayerEntry(plr) end
	end
	
	Players.PlayerAdded:Connect(function(plr)
		if plr ~= LocalPlayer then task.wait(0.1); createPlayerEntry(plr) end
	end)
	
	Players.PlayerRemoving:Connect(function(plr)
		stopFling(plr)
		removePlayerEntry(plr)
	end)   
end;
