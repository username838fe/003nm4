local function C_2()
local script = G2L["2"];
	
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local Workspace = game:GetService("Workspace")
	local RunService = game:GetService("RunService")
	local Camera = Workspace.CurrentCamera
	local ScreenGui = script.Parent
	
	ScreenGui.Name = "FlingGui"
	ScreenGui.ResetOnSpawn = false
	
	-- Cleanup old GUIs
	for _, oldGui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
		if oldGui:IsA("ScreenGui") and oldGui ~= ScreenGui and oldGui.Name == "FlingGui" then
			oldGui:Destroy()
		end
	end
	
	local MainFrame = ScreenGui:WaitForChild("Frame")
	local ScrollingFrame = MainFrame:WaitForChild("ScrollingFrame")
	local Template = ScrollingFrame:WaitForChild("Template")
	Template.Visible = false
	
	local ActiveFlings = {}
	local FlingConnections = {}  -- Changed from threads to Heartbeat connections
	
	local function startFling(targetPlayer)
		if not targetPlayer or targetPlayer == LocalPlayer then return end
	
		-- Stop existing fling
		if FlingConnections[targetPlayer] then
			FlingConnections[targetPlayer]:Disconnect()
			FlingConnections[targetPlayer] = nil
		end
		if ActiveFlings[targetPlayer] then return end
	
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return end
	
	
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = false
				part.CanCollide = (part.Name == "HumanoidRootPart")
				part.Massless = true
			elseif part:IsA("Seat") or part:IsA("VehicleSeat") then
				part:Sit(nil)
			end
		end
	
		hum.PlatformStand = true
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	
		ActiveFlings[targetPlayer] = true
	
	
		task.spawn(function()
			while ActiveFlings[targetPlayer] do
				task.wait()
				local targetChar = targetPlayer.Character
				local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
				if targetHRP then
					Camera.CameraSubject = targetHRP
				else
					break
				end
			end
			if char and char:FindFirstChildOfClass("Humanoid") then
				Camera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
			end
		end)
	
	
		local flingConnection = RunService.Heartbeat:Connect(function()
			if not ActiveFlings[targetPlayer] then
				flingConnection:Disconnect()
				return
			end
	
			local targetChar = targetPlayer.Character
			local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
			local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
	
			if not targetHRP or not targetHum or targetHum.Health <= 0 then
				flingConnection:Disconnect()
				return
			end
	
			local shakeX = math.random(-2, 2) * 0.4
			local shakeZ = math.random(-2, 2) * 0.4
	
			hrp.CFrame = targetHRP.CFrame 
				* CFrame.new(shakeX, -1.5, shakeZ) 
				* CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), 0)
	
			hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			hrp.AssemblyAngularVelocity = Vector3.new(0, 16000, 0)
		end)
	
		FlingConnections[targetPlayer] = flingConnection
	end
	
	local function stopFling(targetPlayer)
		if not targetPlayer then return end
	
		ActiveFlings[targetPlayer] = nil
	
		if FlingConnections[targetPlayer] then
			FlingConnections[targetPlayer]:Disconnect()
			FlingConnections[targetPlayer] = nil
		end
	
		-- Immediate cleanup
		local char = LocalPlayer.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
	
			if hum then
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
			if hrp then
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hrp.CFrame = hrp.CFrame + Vector3.new(0, 5, 0)
			end
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = true
					part.Massless = false
				end
			end
		end
	end
	
	
	local function updateButtonState(clone, player)
		local TextButton = clone:FindFirstChild("TextButton")
		if not TextButton then return end
		if ActiveFlings[player] then
			TextButton.Text = "Flinging"
			TextButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		else
			TextButton.Text = "Fling"
			TextButton.BackgroundColor3 = Color3.fromRGB(60, 255, 100)
		end
	end
	
	local function createPlayerEntry(player)
		if ScrollingFrame:FindFirstChild(player.Name) then return end
		local clone = Template:Clone()
		clone.Name = player.Name
		clone.Parent = ScrollingFrame
		clone.Visible = true
	
		if clone:FindFirstChild("TextLabel") then 
			clone.TextLabel.Text = player.Name 
		end
	
		if clone:FindFirstChild("ImageLabel") then
			task.spawn(function()
				local success, thumb = pcall(function()
					return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
				end)
				if success and thumb then 
					clone.ImageLabel.Image = thumb 
				end
			end)
		end
	
		if clone:FindFirstChild("TextButton") then
			local btn = clone.TextButton
			updateButtonState(clone, player)
			btn.MouseButton1Click:Connect(function()
				local actualPlayer = Players:FindFirstChild(clone.Name)
				if not actualPlayer then return end
				if ActiveFlings[actualPlayer] then
					stopFling(actualPlayer)
				else
					startFling(actualPlayer)
				end
				updateButtonState(clone, actualPlayer)
			end)
		end
	end
	
	local function removePlayerEntry(player)
		local entry = ScrollingFrame:FindFirstChild(player.Name)
		if entry then entry:Destroy() end
	end
	
	-- Init
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then createPlayerEntry(plr) end
	end
	
	Players.PlayerAdded:Connect(function(plr)
		if plr ~= LocalPlayer then task.wait(0.1); createPlayerEntry(plr) end
	end)
	
	Players.PlayerRemoving:Connect(function(plr)
		stopFling(plr)
		removePlayerEntry(plr)
	end)
end;
