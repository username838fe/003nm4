local function C_17()
local script = G2L["17"];
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local LocalPlayer = Players.LocalPlayer
	
	local Camera = workspace.CurrentCamera
	
	-- UI Configurations
	local ScrollingFrame = script.Parent:WaitForChild("ScrollingFrame")
	local Template = ScrollingFrame:WaitForChild("Template")
	Template.Visible = false
	
	local ActiveFlings = {}
	local CurrentTarget = nil
	local FlingConnection = nil
	
	local CameraAngleX = 0
	local CameraAngleY = 0
	local CameraDistance = 15
	
	local function resetCamera()
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			Camera.CameraSubject = LocalPlayer.Character.Humanoid
		end
		Camera.CameraType = Enum.CameraType.Custom
	end
	
	local function updateCamera(targetRoot)
		if not targetRoot then return end
	
		local offset = CFrame.fromEulerAnglesYXZ(math.rad(CameraAngleY), math.rad(CameraAngleX), 0) 
			* CFrame.new(0, 0, CameraDistance)
	
		Camera.CFrame = CFrame.new(targetRoot.Position) * offset
	end
	
	local function spectateTarget(targetRoot)
		if targetRoot then
			Camera.CameraType = Enum.CameraType.Scriptable
			CameraAngleX = 0
			CameraAngleY = 20
			CameraDistance = 15
			updateCamera(targetRoot)
		end
	end
	
	local function clearOldFrames()
		for _, child in pairs(ScrollingFrame:GetChildren()) do
			if child:IsA("Frame") and child.Name ~= "Template" then
				child:Destroy()
			end
		end
	end
	
	local function cleanCharacterPhysics(character)
		if not character then return end
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			for _, name in pairs({"FlingAttachment", "FlingLV", "FlingAV"}) do
				local obj = root:FindFirstChild(name)
				if obj then obj:Destroy() end
			end
		end
		for _, v in pairs(character:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CanCollide = true
				v.Massless = false
			end
		end
	end
	
	local function manageFlingState(targetPlayer, button)
		local targetName = targetPlayer.Name
	
		-- STOP FLINGING
		if ActiveFlings[targetName] then
			ActiveFlings[targetName] = nil
			CurrentTarget = nil
	
			if FlingConnection then
				FlingConnection:Disconnect()
				FlingConnection = nil
			end
	
			resetCamera()
			cleanCharacterPhysics(LocalPlayer.Character)
	
			button.Text = "NOT FLINGING"
			button.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
			return
		end
	
		-- START FLINGING
		local Character = LocalPlayer.Character
		local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
		local TargetChar = targetPlayer.Character
		local TargetRoot = TargetChar and TargetChar:FindFirstChild("HumanoidRootPart")
	
		if not RootPart or not TargetRoot then
			warn("Character or Target not found!")
			return
		end
	
		CurrentTarget = targetPlayer
		ActiveFlings[targetName] = true
		button.Text = "FLINGING"
		button.BackgroundColor3 = Color3.fromRGB(24, 255, 97)
	
		cleanCharacterPhysics(Character)
	
		-- Physics Setup
		for _, v in pairs(Character:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CanCollide = true
				v.Massless = true
			end
		end
	
		local Attachment = Instance.new("Attachment", RootPart)
		Attachment.Name = "FlingAttachment"
	
		local LV = Instance.new("LinearVelocity", RootPart)
		LV.Name = "FlingLV"
		LV.MaxForce = math.huge
		LV.VectorVelocity = Vector3.new(9999, 9999, 9999)
		LV.Attachment0 = Attachment
		LV.RelativeTo = Enum.ActuatorRelativeTo.World
	
		local AV = Instance.new("AngularVelocity", RootPart)
		AV.Name = "FlingAV"
		AV.MaxTorque = math.huge
		AV.AngularVelocity = Vector3.new(0, 9999, 0)
		AV.Attachment0 = Attachment
		AV.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
	
		-- Start Spectating
		spectateTarget(TargetRoot)
	
		-- Fling Loop + Camera Update
		FlingConnection = RunService.PostSimulation:Connect(function()
			if not ActiveFlings[targetName] or not RootPart or not TargetRoot then
				if FlingConnection then FlingConnection:Disconnect() end
				return
			end
	
			local targetVelocity = TargetRoot.AssemblyLinearVelocity
			local predictionOffset = targetVelocity * 0.1
	
			RootPart.CFrame = CFrame.new(TargetRoot.Position + predictionOffset) 
				* CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), math.rad(math.random(0,360)))
	
			updateCamera(TargetRoot)
		end)
	
		-- Right Click Drag Camera (like normal Roblox)
		local dragConnections = {}
	
		table.insert(dragConnections, UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			end
		end))
	
		table.insert(dragConnections, UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
		end))
	
		table.insert(dragConnections, UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement and 
				UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
				CameraAngleX -= input.Delta.X * 0.4
				CameraAngleY = math.clamp(CameraAngleY - input.Delta.Y * 0.4, -80, 80)
			end
		end))
	
		-- Cleanup when fling ends
		task.spawn(function()
			while ActiveFlings[targetName] do task.wait(0.5) end
			for _, conn in ipairs(dragConnections) do
				if conn then conn:Disconnect() end
			end
		end)
	end
	
	-- Player List (Template Section)
	local function updatePlayerList()
		clearOldFrames()
		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local card = Template:Clone()
				card.Name = player.Name
				card.Visible = true
				card.Parent = ScrollingFrame
	
				local imgLabel = card:FindFirstChild("ImageLabel")
				local txtLabel = card:FindFirstChild("TextLabel")
				local txtButton = card:FindFirstChild("TextButton")
	
				if txtLabel then 
					txtLabel.Text = player.Name 
				end
	
				if txtButton then
					local isActive = ActiveFlings[player.Name]
					txtButton.Text = isActive and "FLINGING" or "NOT FLINGING"
					txtButton.BackgroundColor3 = isActive and 
						Color3.fromRGB(24, 255, 97) or Color3.fromRGB(255, 80, 80)
	
					txtButton.MouseButton1Click:Connect(function()
						manageFlingState(player, txtButton)
					end)
				end
	
				if imgLabel then
					task.spawn(function()
						local success, content = pcall(function()
							return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
						end)
						if success then
							imgLabel.Image = content
							imgLabel.ImageTransparency = 0
						end
					end)
				end
			end
		end
	end
	
	Players.PlayerAdded:Connect(updatePlayerList)
	Players.PlayerRemoving:Connect(updatePlayerList)
	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1)
		resetCamera()
	end)
	
	updatePlayerList()
end;
task.spawn(C_17);
-- StarterGui.ScreenGui.Frame.Dragify
local function C_18()
local script = G2L["18"];
	local UIS = game:GetService("UserInputService")
	function dragify(Frame)
		dragToggle = nil
		dragSpeed = 0.15
		dragInput = nil
		dragStart = nil
		dragPos = nil
		function updateInput(input)
			Delta = input.Position - dragStart
			Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + Delta.X, startPos.Y.Scale, startPos.Y.Offset + Delta.Y)
			game:GetService("TweenService"):Create(Frame, TweenInfo.new(0.15), {Position = Position}):Play()
		end
		Frame.InputBegan:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UIS:GetFocusedTextBox() == nil then
				dragToggle = true
				dragStart = input.Position
				startPos = Frame.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragToggle = false
					end
				end)
			end
		end)
		Frame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
		game:GetService("UserInputService").InputChanged:Connect(function(input)
			if input == dragInput and dragToggle then
				updateInput(input)
			end
		end)
	end
	dragify(script.Parent)
	
end;
task.spawn(C_18);
