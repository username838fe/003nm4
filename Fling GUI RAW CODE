-- StarterGui.ScreenGui.FlingLogic
local function C_2()
local script = G2L["2"];
	-- LocalScript → Inside ScreenGui
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")
	
	local ScreenGui = script.Parent
	ScreenGui.Name = "FlingGui"
	ScreenGui.ResetOnSpawn = false
	
	for _, oldGui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
		if oldGui:IsA("ScreenGui") and oldGui ~= ScreenGui then
			if oldGui.Name == "FlingGui" or (oldGui:FindFirstChild("Frame") and oldGui.Frame:FindFirstChild("ScrollingFrame")) then
				oldGui:Destroy()
			end
		end
	end
	
	local MainFrame = ScreenGui:WaitForChild("Frame")
	local ScrollingFrame = MainFrame:WaitForChild("ScrollingFrame")
	local Template = ScrollingFrame:WaitForChild("Template")
	
	local ActiveFlings = {}
	
	local function startFling(targetPlayer)
		if ActiveFlings[targetPlayer] then return end
		if not targetPlayer or targetPlayer == LocalPlayer then return end
	
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
	
		if not hrp or not hum then return end
	
		ActiveFlings[targetPlayer] = true
	
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.Massless = true
			end
		end
	
		hum.PlatformStand = true
	
		local connection = RunService.Heartbeat:Connect(function()
			if not ActiveFlings[targetPlayer] then return end
	
			local targetChar = targetPlayer.Character
			local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
			if not targetHRP then
				stopFling(targetPlayer)
				return
			end
	
			hrp.CFrame = targetHRP.CFrame
	
			local targetVel = targetHRP.Velocity
			local force = targetVel * 4 + Vector3.new(math.random(-1400,1400), 4200, math.random(-1400,1400))
	
			hrp.AssemblyLinearVelocity = force
			hrp.Velocity = force * 3
			hrp.AssemblyAngularVelocity = Vector3.new(0, 150000, 0)
	
			pcall(function() hum:Move(Vector3.new(0, 3500, 0)) end)
			pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", targetHRP) end)
		end)
	
		ActiveFlings[targetPlayer] = connection
	end
	
	local function stopFling(targetPlayer)
		if ActiveFlings[targetPlayer] and typeof(ActiveFlings[targetPlayer]) == "RBXScriptConnection" then
			ActiveFlings[targetPlayer]:Disconnect()
		end
		ActiveFlings[targetPlayer] = nil
	
		local char = LocalPlayer.Character
		if not char then return end
	
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
	
		if hum then hum.PlatformStand = false end
	
		task.wait(0.1)
	
		if hrp then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.Velocity = Vector3.zero
			pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", nil) end)
			hrp.CFrame = hrp.CFrame + Vector3.new(0, 15, 0)
		end
	
		task.wait(0.2)
	
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
				part.Massless = false
			end
		end
	
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end
	end
	
	-- Player List (same as before)
	local function setupPlayerEntry(player, clone)
		clone.Name = player.Name
		local ImageLabel = clone:FindFirstChild("ImageLabel")
		local TextLabel = clone:FindFirstChild("TextLabel")
		local TextButton = clone:FindFirstChild("TextButton")
	
		if TextLabel then TextLabel.Text = player.Name end
	
		if ImageLabel then
			task.spawn(function()
				local thumb = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
				if thumb then ImageLabel.Image = thumb end
			end)
		end
	
		local isFlinging = false
		if TextButton then
			TextButton.Text = "Fling"
			TextButton.BackgroundColor3 = Color3.fromRGB(60, 255, 100)
	
			TextButton.MouseButton1Click:Connect(function()
				isFlinging = not isFlinging
				if isFlinging then
					TextButton.Text = "Flinging"
					TextButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
					startFling(player)
				else
					TextButton.Text = "Fling"
					TextButton.BackgroundColor3 = Color3.fromRGB(60, 255, 100)
					stopFling(player)
				end
			end)
		end
	
		player.Destroying:Connect(function()
			stopFling(player)
			clone:Destroy()
		end)
	end
	
	local function refreshList()
		local playerList = {}
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				table.insert(playerList, plr)
			end
		end
	
		for _, child in pairs(ScrollingFrame:GetChildren()) do
			if child ~= Template and child:IsA("Frame") then
				child:Destroy()
			end
		end
	
		if #playerList == 0 then return end
	
		setupPlayerEntry(playerList[1], Template)
		Template.Visible = true
	
		for i = 2, #playerList do
			local clone = Template:Clone()
			clone.Parent = ScrollingFrame
			setupPlayerEntry(playerList[i], clone)
		end
	end
	
	Players.PlayerAdded:Connect(function(plr)
		if plr ~= LocalPlayer then task.wait(0.5) refreshList() end
	end)
	
	Players.PlayerRemoving:Connect(function(plr)
		stopFling(plr)
		task.wait(0.3)
		refreshList()
	end)
	
	refreshList()
end;
task.spawn(C_2);
