Closure = function()
    local script = G2L["26"];-- NotificationModule – FINAL STACKING VERSION (With Hidden Position Handling)
-- ModuleScript (place in ReplicatedStorage or StarterPlayerScripts)

local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Notification = {}

-- Config
local TWEEN_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

-- POSITION CONFIG
local VISIBLE = UDim2.new(0.752, 0, 0.861, 0) -- Target X/Y for the stack area
local HIDDEN = UDim2.new(1, 0, 0.856, 0)      -- NEW: Position when hidden/off-screen
local SPACING = 0.15                          -- Vertical spacing between stacked notifications
local MAX_NOTIFS = 7                          -- Maximum visible notifications

-- Shared sound
local sound = SoundService:FindFirstChild("NotifSound") or Instance.new("Sound")
sound.Name = "NotifSound"
sound.SoundId = "rbxassetid://131390520971848"
sound.Volume = 1
sound.Parent = SoundService

-- Track active notifications
local activeNotifs = {}

-- Map notification types to colors
local typeColors = {
	Success = Color3.fromRGB(0, 191, 48),
	Warn = Color3.fromRGB(191, 191, 0),
	Error = Color3.fromRGB(255, 0, 0),
	Information = Color3.fromRGB(75, 75, 75)
}

-- Map notification types to image asset IDs
local typeImages = {
	Success = "rbxassetid://71999740929125",
	Warn = "rbxassetid://83610207246939",
	Error = "rbxassetid://5107154093",
	Information = "rbxassetid://4871684516"
}

-- Helper to calculate target positions and tween the stack
local function updateStack()
	for i, frame in ipairs(activeNotifs) do
		-- Calculate target Y based on stack order (newest at bottom)
		-- We use VISIBLE.X and VISIBLE.Y.Offset as the base anchor for the stack
		local offsetY = VISIBLE.Y.Scale - (SPACING * (#activeNotifs - i))
		local targetPos = UDim2.new(VISIBLE.X.Scale, VISIBLE.X.Offset, offsetY, VISIBLE.Y.Offset)

		-- Tween to the calculated position
		TweenService:Create(frame, TWEEN_INFO, { Position = targetPos }):Play()
	end
end

-- Public function
function Notification.Notify(templateFrame, message, notifType)
	if not templateFrame or not templateFrame:IsA("GuiObject") then
		return
	end

	-- Clone a fresh frame
	local frame = templateFrame:Clone()
	frame.Parent = templateFrame.Parent
	frame.Visible = true

	-- 1. Set Initial Position to HIDDEN
	frame.Position = HIDDEN

	-- Start invisible (transparency)
	frame.BackgroundTransparency = 1

	-- Update text and image
	local main = frame:FindFirstChild("Main")
	if main then
		local label = main:FindFirstChild("TextBox") or main:FindFirstChild("Text") or main:FindFirstChild("TextLabel")
		if label then
			label.Text = message
			label.TextTransparency = 1
		end

		local icon = main:FindFirstChild("ImageLabel")
		if icon and notifType and typeImages[notifType] then
			icon.Image = ""
			icon.Image = typeImages[notifType]
			icon.ImageTransparency = 1
		end
	end

	-- Apply color
	if notifType and typeColors[notifType] then
		frame.BackgroundColor3 = typeColors[notifType]
	end

	-- Add to active list
	table.insert(activeNotifs, frame)

	-- Handle max notifications
	if #activeNotifs > MAX_NOTIFS then
		local oldest = table.remove(activeNotifs, 1)
		-- Tween oldest to HIDDEN before destroying to keep it smooth
		TweenService:Create(oldest, TWEEN_INFO, { 
			Position = HIDDEN, 
			BackgroundTransparency = 1 
		}):Play()

		if main then
			local label = oldest:FindFirstChild("Main") and (oldest.Main:FindFirstChild("TextBox") or oldest.Main:FindFirstChild("TextLabel"))
			local icon = oldest:FindFirstChild("Main") and oldest.Main:FindFirstChild("ImageLabel")
			if label then TweenService:Create(label, TWEEN_INFO, { TextTransparency = 1 }):Play() end
			if icon then TweenService:Create(icon, TWEEN_INFO, { ImageTransparency = 1 }):Play() end
		end

		task.delay(TWEEN_INFO.Time, function()
			oldest:Destroy()
		end)
	end

	-- 2. Tween IN: Move from HIDDEN to Stack Position & Fade In
	updateStack() -- This tweens the new frame (and shifts others) to their visible spots

	TweenService:Create(frame, TWEEN_INFO, { BackgroundTransparency = 0 }):Play()
	if main then
		local label = main:FindFirstChild("TextBox") or main:FindFirstChild("Text") or main:FindFirstChild("TextLabel")
		if label then
			TweenService:Create(label, TWEEN_INFO, { TextTransparency = 0 }):Play()
		end
		local icon = main:FindFirstChild("ImageLabel")
		if icon then
			TweenService:Create(icon, TWEEN_INFO, { ImageTransparency = 0 }):Play()
		end
	end

	sound:Play()

	-- Hide after 4 seconds
	task.delay(4, function()
		-- 3. Tween OUT: Move to HIDDEN position & Fade Out
		TweenService:Create(frame, TWEEN_INFO, { 
			Position = HIDDEN, 
			BackgroundTransparency = 1 
		}):Play()

		if main then
			local label = main:FindFirstChild("TextBox") or main:FindFirstChild("Text") or main:FindFirstChild("TextLabel")
			if label then
				TweenService:Create(label, TWEEN_INFO, { TextTransparency = 1 }):Play()
			end
			local icon = main:FindFirstChild("ImageLabel")
			if icon then
				TweenService:Create(icon, TWEEN_INFO, { ImageTransparency = 1 }):Play()
			end
		end

		task.delay(TWEEN_INFO.Time, function()
			frame:Destroy()

			-- Remove from list and re-calculate stack
			for i, f in ipairs(activeNotifs) do
				if f == frame then
					table.remove(activeNotifs, i)
					break
				end
			end

			-- Tween remaining items to fill the gap
			updateStack()
		end)
	end)
