-- StarterGui.ScreenGui.Frame.TextButton.LocalScript
local function C_d()
local script = G2L["d"];
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local ContextActionService = game:GetService("ContextActionService")
	
	local player = Players.LocalPlayer
	local camera = workspace.CurrentCamera
	local button = script.Parent
	
	-- NEW: Reference the TextBox sitting next to the button in the hierarchy
	local uiParent = button.Parent
	local textBox = uiParent:WaitForChild("TextBox")
	
	-- Configuration Defaults
	local CAMERA_SPEED = 30 
	local MOUSE_SENSITIVITY = 0.5
	local ACCELERATION_SPEED = 12 
	local FREE_CAM_ACTION = "FreecamFreezeMovement"
	
	-- State variables
	local isEnabled = false
	local isRightMouseDown = false
	local rotationX = 0
	local rotationY = 0
	local cameraCFrame = camera.CFrame
	local currentVelocity = Vector3.new(0, 0, 0)
	
	-- Connections store
	local renderConnection = nil
	local inputBeganConnection = nil
	local inputEndedConnection = nil
	local inputChangedConnection = nil
	
	-- Set initial values on UI items
	button.Text = "FREECAM: OFF"
	textBox.Text = tostring(CAMERA_SPEED)
	
	-- NEW: Sanitize the TextBox to strip out non-numeric characters and update speed
	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		local cleanText = string.gsub(textBox.Text, "%D", "") -- Deletes everything that is not a number
	
		if cleanText ~= textBox.Text then
			textBox.Text = cleanText -- Enforce number-only text rule visually
		end
	
		-- Convert clean string to a number object
		local newSpeedValue = tonumber(cleanText)
		if newSpeedValue and newSpeedValue > 0 then
			CAMERA_SPEED = newSpeedValue -- Real-time speed shift applied directly
		end
	end)
	
	-- Track keystrokes for camera movement
	local function getMovementVector()
		local forward = 0
		local right = 0
		local up = 0
	
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then forward = forward + 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then forward = forward - 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then right = right + 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then right = right - 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) then up = up + 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) then up = up - 1 end
	
		local rawVector = Vector3.new(right, up, forward)
		if rawVector.Magnitude > 0 then
			return rawVector.Unit
		end
		return rawVector
	end
	
	-- Turn Freecam ON
	local function enableFreecam()
		cameraCFrame = camera.CFrame
	
		local rx, ry, rz = cameraCFrame:ToOrientation()
		rotationX = math.deg(ry)
		rotationY = math.deg(rx)
	
		ContextActionService:BindAction(
			FREE_CAM_ACTION,
			function() return Enum.ContextActionResult.Sink end,
			false,
			Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space
		)
	
		camera.CameraType = Enum.CameraType.Scriptable
	
		inputBeganConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				isRightMouseDown = true
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
				UserInputService.MouseIconEnabled = false
			end
		end)
	
		inputEndedConnection = UserInputService.InputEnded:Connect(function(input, gameProcessed)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				isRightMouseDown = false
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
			end
		end)
	
		inputChangedConnection = UserInputService.InputChanged:Connect(function(input, gameProcessed)
			if input.UserInputType == Enum.UserInputType.MouseMovement and isRightMouseDown then
				local delta = input.Delta
				rotationX = rotationX - (delta.X * MOUSE_SENSITIVITY)
				rotationY = rotationY - (delta.Y * MOUSE_SENSITIVITY)
				rotationY = math.clamp(rotationY, -80, 80)
			end
		end)
	
		renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
			-- Reads whatever CAMERA_SPEED currently is in global memory space
			local maxSpeed = CAMERA_SPEED
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				maxSpeed = CAMERA_SPEED * 3 
			end
	
			local finalRotation = CFrame.fromEulerAnglesYXZ(math.rad(rotationY), math.rad(rotationX), 0)
	
			local targetVector = getMovementVector()
			local targetMovement = finalRotation:VectorToWorldSpace(Vector3.new(targetVector.X, 0, -targetVector.Z)) 
			local targetVertical = Vector3.new(0, targetVector.Y, 0)
	
			local totalTargetVelocity = (targetMovement + targetVertical) * maxSpeed
	
			local alpha = math.clamp(deltaTime * ACCELERATION_SPEED, 0, 1)
			currentVelocity = currentVelocity:Lerp(totalTargetVelocity, alpha)
	
			local currentPosition = cameraCFrame.Position
			local newPosition = currentPosition + (currentVelocity * deltaTime)
	
			cameraCFrame = CFrame.new(newPosition) * finalRotation
			camera.CFrame = cameraCFrame
		end)
	end
	
	-- Turn Freecam OFF
	local function disableFreecam()
		ContextActionService:UnbindAction(FREE_CAM_ACTION)
	
		if renderConnection then renderConnection:Disconnect() renderConnection = nil end
		if inputBeganConnection then inputBeganConnection:Disconnect() inputBeganConnection = nil end
		if inputEndedConnection then inputEndedConnection:Disconnect() inputEndedConnection = nil end
		if inputChangedConnection then inputChangedConnection:Disconnect() inputChangedConnection = nil end
	
		isRightMouseDown = false
		currentVelocity = Vector3.new(0, 0, 0)
	
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	
		camera.CameraType = Enum.CameraType.Custom
	end
	
	-- Trigger click cycle event handler
	button.Activated:Connect(function()
		isEnabled = not isEnabled
	
		if isEnabled then
			button.Text = "FREECAM: ON"
			enableFreecam()
		else
			button.Text = "FREECAM: OFF"
			disableFreecam()
		end
	end)
	
end;
task.spawn(C_d);
-- StarterGui.ScreenGui.Frame.Dragify
local function C_e()
local script = G2L["e"];
	local UIS = game:GetService("UserInputService")
	function dragify(Frame)
		dragToggle = nil
		dragSpeed = 0.15
		dragInput = nil
		dragStart = nil
		dragPos = nil
		function updateInput(input)
			Delta = input.Position - dragStart
			Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + Delta.X, startPos.Y.Scale, startPos.Y.Offset + Delta.Y)
			game:GetService("TweenService"):Create(Frame, TweenInfo.new(0.15), {Position = Position}):Play()
		end
		Frame.InputBegan:Connect(function(input)
			if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UIS:GetFocusedTextBox() == nil then
				dragToggle = true
				dragStart = input.Position
				startPos = Frame.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragToggle = false
					end
				end)
			end
		end)
		Frame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
		game:GetService("UserInputService").InputChanged:Connect(function(input)
			if input == dragInput and dragToggle then
				updateInput(input)
			end
		end)
	end
	dragify(script.Parent)
	
end;
