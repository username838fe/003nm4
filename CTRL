		local cursor = textBox.CursorPosition
		
		-- Detect insertion
		if #currentText == #lastText + 1 then
			local typedChar = currentText:sub(cursor - 1, cursor - 1)
			
			local function insertPair(openChar, closeChar)
				local before = currentText:sub(1, cursor - 2)
				local after = currentText:sub(cursor)
				textBox.Text = before .. openChar .. closeChar .. after
				textBox.CursorPosition = #before + 2
			end
			
			if typedChar == "(" then
				insertPair("(", ")")
			elseif typedChar == "\"" then
				insertPair("\"", "\"")
			elseif typedChar == "'" then
				insertPair("'", "'")
			end
			
			-- Detect deletion of opening char
		elseif #currentText == #lastText - 1 then
			local deletedPos = cursor
			local deletedChar = lastText:sub(deletedPos, deletedPos)
			local nextChar = currentText:sub(deletedPos, deletedPos)
			
			local function shouldDeletePair(openChar, closeChar)
				return deletedChar == openChar and nextChar == closeChar
			end
			
			if shouldDeletePair("(", ")") or shouldDeletePair("\"", "\"") or shouldDeletePair("'", "'") then
				local before = currentText:sub(1, deletedPos - 1)
				local after = currentText:sub(deletedPos + 1)
