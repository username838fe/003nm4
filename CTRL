    local script = G2L["90"];--// NotificationModule – FINAL STACKING VERSION (Transparency Tween Only)
--// ModuleScript (place in ReplicatedStorage or StarterPlayerScripts)

local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Notification = {}

-- Config
local TWEEN_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local VISIBLE    = UDim2.new(0.752, 0, 0.861, 0)
local SPACING    = 0.15 -- vertical spacing between stacked notifications
local MAX_NOTIFS = 7    -- maximum visible notifications

-- Shared sound (create once, reuse)
local sound = SoundService:FindFirstChild("NotifSound") or Instance.new("Sound")
sound.Name = "NotifSound"
sound.SoundId = "rbxassetid://4590662766"
sound.Volume = 1
sound.Parent = SoundService

-- Track active notifications
local activeNotifs = {}

-- Map notification types to colors
local typeColors = {
	Success     = Color3.fromRGB(0, 191, 48),   -- Green
	Warn        = Color3.fromRGB(191, 191, 0),  -- Yellow
	Error       = Color3.fromRGB(255, 0, 0),    -- Red
	Information = Color3.fromRGB(255, 255, 255) -- White
}

-- Helper to reposition stack (bottom‑aligned, instant positioning)
local function repositionStack()
	for i, frame in ipairs(activeNotifs) do
		-- newest at bottom, oldest at top
		local offsetY = VISIBLE.Y.Scale - (SPACING * (#activeNotifs - i))
		local targetPos = UDim2.new(VISIBLE.X.Scale, VISIBLE.X.Offset, offsetY, VISIBLE.Y.Offset)
		frame.Position = targetPos -- set instantly, no tween
	end
end

-- Public function
function Notification.Notify(templateFrame, message, notifType)
	if not templateFrame or not templateFrame:IsA("GuiObject") then return end
	
	-- Clone a fresh frame
	local frame = templateFrame:Clone()
	frame.Parent = templateFrame.Parent
	frame.Visible = true
	frame.BackgroundTransparency = 1 -- start invisible
	
	-- Update text
	local main = frame:FindFirstChild("Main")
	if main then
		local label = main:FindFirstChild("TextBox") or main:FindFirstChild("Text") or main:FindFirstChild("TextLabel")
		if label then
			label.Text = message
			label.TextTransparency = 1 -- start invisible
		end
	end
	
	-- Apply color
	if notifType and typeColors[notifType] then
		frame.BackgroundColor3 = typeColors[notifType]
		local stroke = frame:FindFirstChildOfClass("UIStroke")
		if stroke then stroke.Color = typeColors[notifType] end
	end
	
	-- Add newest notification to the list
	table.insert(activeNotifs, frame)
	
	-- If too many, drop the oldest
	if #activeNotifs > MAX_NOTIFS then
		local oldest = table.remove(activeNotifs, 1)
		oldest:Destroy()
	end
	
	-- Reposition stack instantly
	repositionStack()
	
	-- Fade in to semi‑transparent background
	TweenService:Create(frame, TWEEN_INFO, {BackgroundTransparency = 0.5}):Play()
	if main then
		local label = main:FindFirstChild("TextBox") or main:FindFirstChild("Text") or main:FindFirstChild("TextLabel")
		if label then
			TweenService:Create(label, TWEEN_INFO, {TextTransparency = 0}):Play()
		end
	end
	sound:Play()
	
	-- Hide after 4 seconds
	task.delay(4, function()
		-- Fade out in place (no position change)
		TweenService:Create(frame, TWEEN_INFO, {BackgroundTransparency = 1}):Play()
		if main then
			local label = main:FindFirstChild("TextBox") or main:FindFirstChild("Text") or main:FindFirstChild("TextLabel")
			if label then
				TweenService:Create(label, TWEEN_INFO, {TextTransparency = 1}):Play()
			end
		end
		task.delay(TWEEN_INFO.Time, function()
			frame:Destroy()
			-- Remove from active list
			for i, f in ipairs(activeNotifs) do
				if f == frame then
					table.remove(activeNotifs, i)
					break
				end
			end
			-- Reposition stack instantly so others slide down
			repositionStack()
		end)
	end)
end

return Notification
end;
