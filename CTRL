	bar.Size = UDim2.new(0, 0, 1, 0)
	progressText.Text = "0%"
	
	-- Tween Info settings
	local tweenInfo1 = TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tweenInfo2 = TweenInfo.new(0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	
	-- Goals
	local goalPositions = {
		Phase1 = UDim2.new(0.93, 0, 1, 0),
		Phase2 = UDim2.new(1.00, 0, 1, 0)
	}
	
	-- Create animations
	local tween1 = TweenService:Create(bar, tweenInfo1, {Size = goalPositions.Phase1})
	local tween2 = TweenService:Create(bar, tweenInfo2, {Size = goalPositions.Phase2})
	
	-- Listen for bar size changes to update text percentage
	local connection
	connection = bar:GetPropertyChangedSignal("Size"):Connect(function()
		local currentScale = bar.Size.X.Scale
		local percentage = math.floor(currentScale * 100)
		progressText.Text = percentage .. "%"
	end)
	
	-- Sequence Execution
	tween1:Play()
	tween1.Completed:Wait()
	
	task.wait(0.7)
	
	tween2:Play()
	tween2.Completed:Wait()
	
	-- Clean up connection when finished
	if connection then
		connection:Disconnect()
	end
	
end;
