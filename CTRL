local function C_d2()
local script = G2L["d2"];
	local Highlighter = require(script:WaitForChild("Highlighter"))  -- Adjust path if needed
	
	local textBox = script.Parent  -- Your TextBox
	
	-- Enable necessary properties
	textBox.RichText = false  -- Highlighter manages its own labels, so disable on the main TextBox
	textBox.BackgroundColor3 = Highlighter.getTokenColor("background")  -- Optional: match background
	
	-- First: Match Studio's current Script Editor theme (gets correct colors for everything)
	Highlighter.matchStudioSettings()
	
	-- Then: Override ONLY the keyword color to red
	Highlighter.setTokenColors({
		keyword = Color3.fromRGB(255, 0, 0),   -- Bright red (adjust if you want darker/softer)
		-- You can override others here if needed, but we only change keywords
		number = Color3.fromRGB(255, 170, 0),
		string = Color3.fromRGB(0, 255, 0),
		
		builtin = Color3.fromRGB(0, 170, 255),
	})
	
	-- Apply highlighting
	local cleanup = Highlighter.highlight({
		textObject = textBox,
	})
	
	-- Optional: cleanup() when you're done (e.g., on GUI destroy)
	
end;
task.spawn(C_d2);
