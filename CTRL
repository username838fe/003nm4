local function C_b8()
local script = G2L["b8"];
	local CollectionService = game:GetService("CollectionService")
	
	local button = script.Parent
	local tagName = "LiquidGlass"
	
	-- 1. Define your two frames here
	local frame1 = button.Parent.Parent
	local frame2 = frame1.Parent.NotifySystem.Frame
	
	-- 2. Store them in a table
	local framesToToggle = {frame1, frame2}
	
	button.MouseButton1Click:Connect(function()
		for _, frame in ipairs(framesToToggle) do
			if frame then
				-- Toggle the tag based on whether it currently exists
				if CollectionService:HasTag(frame, tagName) then
					CollectionService:RemoveTag(frame, tagName)
					print("Tag '" .. tagName .. "' was successfully removed from " .. frame.Name)
				else
					CollectionService:AddTag(frame, tagName)
					print("Tag '" .. tagName .. "' was successfully added to " .. frame.Name)
				end
			else
				warn("One of the defined frames does not exist.")
			end
		end
	end)
	
end;
task.spawn(C_b8);
